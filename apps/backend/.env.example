APP_NAME=VisaSponsor API
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/visasponsor
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visasponsor
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300
REQUESTS_PER_MINUTE=120
CORS_ORIGINS=["http://localhost:3000"]

CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain
CLERK_AUDIENCE=
ALLOW_DEV_AUTH_BYPASS=true
DEV_AUTH_USER_ID=user_dev_123
DEV_AUTH_EMAIL=dev@example.com

DOL_DATASET_BASE_URL=https://www.dol.gov/sites/dolgov/files/ETA/oflc/pdfs
ADMIN_INGESTION_TOKEN=replace-with-strong-token
